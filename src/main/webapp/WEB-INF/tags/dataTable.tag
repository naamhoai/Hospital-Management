<%@ tag pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %>
<%@ attribute name="rows" required="true" type="java.util.List" %>
<c:choose><c:when test="${empty rows}"><p class="muted">Không có dữ liệu.</p></c:when><c:otherwise><div class="table-wrap"><table><thead><tr><c:forEach items="${rows[0]}" var="cell"><th><c:out value="${empty applicationScope.labels[cell.key] ? cell.key : applicationScope.labels[cell.key]}"/></th></c:forEach></tr></thead><tbody><c:forEach items="${rows}" var="row"><tr><c:forEach items="${row}" var="cell"><td><c:choose><c:when test="${cell.key=='status' || cell.key=='payment_status' || cell.key=='payment_method' || cell.key=='priority_type' || cell.key=='category' || cell.key=='shift' || cell.key=='Phương thức'}"><c:out value="${empty applicationScope.labels[cell.value] ? cell.value : applicationScope.labels[cell.value]}"/></c:when><c:when test="${cell.key=='Doanh thu (VND)' || cell.key=='unit_price' || cell.key=='total_amount' || cell.key=='amount' || cell.key=='consultation_fee'}"><fmt:formatNumber value="${cell.value}"/></c:when><c:otherwise><c:out value="${cell.value}"/></c:otherwise></c:choose></td></c:forEach></tr></c:forEach></tbody></table></div></c:otherwise></c:choose>
