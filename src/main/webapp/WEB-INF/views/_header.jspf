<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %>
<%@ taglib prefix="ui" tagdir="/WEB-INF/tags" %>
<!doctype html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Hospital · Quản lý khám bệnh</title>
<link rel="stylesheet" href="${pageContext.request.contextPath}/assets/app.css">
<script defer src="${pageContext.request.contextPath}/assets/app.js">
</script>
</head>
<body>
<c:set var="ctx" value="${pageContext.request.contextPath}"/>
<c:set var="role" value="${sessionScope.user.role}"/>
<header>
<a class="brand" href="${ctx}/dashboard">
<span class="brand-mark">H</span> Hospital <small>CARE WORKSPACE</small>
</a>
<div class="identity">
<c:if test="${not empty sessionScope.user}">
<span>
<c:out value="${sessionScope.user.fullName}"/> · <c:out value="${empty applicationScope.labels[role] ? role : applicationScope.labels[role]}"/>
</span>
<form class="inline" method="post" action="${ctx}/logout">
<input type="hidden" name="csrf" value="${sessionScope.csrf}">
<button class="secondary">Đăng xuất</button>
</form>
</c:if>
</div>
</header>
<nav aria-label="Điều hướng chính">
<span class="nav-label">KHÔNG GIAN LÀM VIỆC</span>
<a href="${ctx}/dashboard">Tổng quan</a>
<a href="${ctx}/search">Tìm bác sĩ & dịch vụ</a>
<c:if test="${role=='PATIENT'}">
<a href="${ctx}/appointments">Lịch khám của tôi</a>
<a href="${ctx}/my-records">Hồ sơ & hóa đơn</a>
<a href="${ctx}/feedback">Đánh giá</a>
</c:if>
<c:if test="${role=='DOCTOR' || role=='ADMIN'}">
<a href="${ctx}/schedules">Ca làm việc</a>
</c:if>
<c:if test="${role=='RECEPTIONIST' || role=='ADMIN'}">
<a href="${ctx}/reception">Tiếp nhận</a>
</c:if>
<c:if test="${role=='RECEPTIONIST' || role=='DOCTOR' || role=='ADMIN'}">
<a href="${ctx}/queue">Hàng đợi</a>
</c:if>
<c:if test="${role=='DOCTOR'}">
<a href="${ctx}/emr">Bệnh án & kê đơn</a>
</c:if>
<c:if test="${role=='LAB_TECHNICIAN'}">
<a href="${ctx}/lab">Kết quả xét nghiệm</a>
</c:if>
<c:if test="${role=='CASHIER' || role=='ADMIN'}">
<a href="${ctx}/billing">Thu ngân</a>
</c:if>
<c:if test="${role=='MANAGER' || role=='ADMIN'}">
<a href="${ctx}/services">Danh mục dịch vụ</a>
<a href="${ctx}/reports">Báo cáo</a>
</c:if>
<c:if test="${empty role}">
<a href="${ctx}/login">Đăng nhập</a>
</c:if>
</nav>
<main>
<c:if test="${not empty sessionScope.flash}">
<div class="notice" role="status">
<c:out value="${sessionScope.flash}"/>
</div>
<c:remove var="flash" scope="session"/>
</c:if>

<c:if test="${not empty error}">
<div class="notice error" role="alert">
<c:out value="${error}"/>
</div>
</c:if>
