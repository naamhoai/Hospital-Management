<%@ include file="_header.jspf" %><h1>Bệnh án điện tử · EMR</h1>
<div class="card"><h2>Bệnh án được phân công</h2><div class="table-wrap"><table><thead><tr><th>Mã bệnh án / queueId</th><th>Bệnh nhân</th><th>Chẩn đoán</th><th>Trạng thái</th><th></th></tr></thead><tbody><c:forEach items="${records}" var="m"><tr><td>#${m.record_id} / ${m.queue_id}</td><td><c:out value="${m.patient_name}"/></td><td><c:out value="${m.diagnosis}"/></td><td><c:out value="${m.status}"/></td><td><a href="${ctx}/emr?queueId=${m.queue_id}">Mở bệnh án</a></td></tr></c:forEach></tbody></table></div></div>
<c:if test="${not empty record}"><div class="card"><h2>Bệnh án #${record.record_id} · lượt khám ${record.queue_id}</h2><c:choose><c:when test="${record.status=='OPEN'}"><form method="post"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="action" value="diagnosis"><input type="hidden" name="queueId" value="${record.queue_id}"><label>Triệu chứng *</label><textarea name="symptoms" required maxlength="5000"><c:out value="${record.symptoms}"/></textarea><label>Mã bệnh ICD *</label><select name="icdCode" required><option value="">Chọn mã bệnh</option><c:forEach items="${icds}" var="icd"><option value="${icd.code}" ${record.icd_code==icd.code?'selected':''}><c:out value="${icd.code}"/> · <c:out value="${icd.description}"/></option></c:forEach></select><label>Chẩn đoán *</label><input name="diagnosis" required maxlength="255" value="<c:out value='${record.diagnosis}'/>"><label>Ghi chú</label><textarea name="notes" maxlength="5000"><c:out value="${record.notes}"/></textarea><p></p><button>Lưu chẩn đoán</button></form></c:when><c:otherwise><p>Bệnh án đã kết thúc: <c:out value="${record.diagnosis}"/> · <c:out value="${record.icd_code}"/></p></c:otherwise></c:choose></div>
<div class="card"><h2>Lịch sử khám đã hoàn tất của bệnh nhân</h2><ui:dataTable rows="${history}"/></div>
<c:if test="${record.status=='OPEN'}"><div class="card"><h2>Chỉ định xét nghiệm / dịch vụ</h2><form method="post" action="${ctx}/clinical-orders"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="recordId" value="${record.record_id}"><input type="hidden" name="queueId" value="${record.queue_id}"><c:forEach items="${services}" var="service"><label><input type="checkbox" name="serviceId" value="${service.service_id}"> <c:out value="${service.name}"/> · <fmt:formatNumber value="${service.unit_price}"/> VND</label></c:forEach><label>Chỉ dẫn</label><input name="instructions" maxlength="255"><p></p><button>Tạo chỉ định</button></form></div>
<div class="card"><h2>Kê đơn thuốc điện tử</h2><p class="muted">Sử dụng thuốc demo để kiểm tra phần mềm. Liều dùng do bác sĩ nhập.</p><form method="post" action="${ctx}/prescriptions"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="recordId" value="${record.record_id}"><div id="med-items"><div class="med-row"><select name="medicationId" required><option value="">Chọn thuốc</option><c:forEach items="${medications}" var="med"><option value="${med.medication_id}"><c:out value="${med.name}"/> · tồn ${med.stock_quantity}</option></c:forEach></select><input type="number" name="quantity" min="1" max="1000" placeholder="Số lượng" required><input name="dosage" maxlength="100" placeholder="Liều dùng" required><button type="button" class="secondary" data-remove-med>Xóa dòng</button></div></div><button type="button" class="secondary" data-add-med>+ Thêm thuốc</button><label>Lời dặn</label><input name="advice" maxlength="255"><p></p><button>Phát hành đơn thuốc</button></form>
<template id="med-template"><div class="med-row"><select name="medicationId" required><option value="">Chọn thuốc</option><c:forEach items="${medications}" var="med"><option value="${med.medication_id}"><c:out value="${med.name}"/> · tồn ${med.stock_quantity}</option></c:forEach></select><input type="number" name="quantity" min="1" max="1000" placeholder="Số lượng" required><input name="dosage" maxlength="100" placeholder="Liều dùng" required><button type="button" class="secondary" data-remove-med>Xóa dòng</button></div></template></div></c:if>
<div class="card"><h2>Chỉ định và kết quả xét nghiệm</h2><ui:dataTable rows="${orders}"/></div><div class="card"><h2>Đơn thuốc</h2><c:forEach items="${prescriptions}" var="rx"><p><a href="${ctx}/prescriptions?id=${rx.prescription_id}">Đơn #${rx.prescription_id} · ${rx.prescribed_date}</a> · <c:out value="${rx.payment_status}"/></p></c:forEach></div>
<c:if test="${record.status=='OPEN'}"><div class="card"><form method="post" data-confirm="Kết thúc bệnh án sẽ khóa chỉnh sửa chẩn đoán và kê đơn. Tiếp tục?"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="action" value="close"><input type="hidden" name="queueId" value="${record.queue_id}"><button>Kết thúc khám</button></form></div></c:if></c:if><%@ include file="_footer.jspf" %>
