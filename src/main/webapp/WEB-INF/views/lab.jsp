<%@ include file="_header.jspf" %><h1>Kết quả xét nghiệm</h1><div class="card"><h2>Danh sách chỉ định</h2><ui:dataTable rows="${orders}"/></div><div class="card"><h2>Nhập & duyệt kết quả</h2><p class="muted">Chỉ nhập sau thanh toán. Kết quả đã duyệt được khóa chỉnh sửa.</p><form method="post" data-confirm="Duyệt kết quả này? Sau khi duyệt sẽ không thể chỉnh sửa trên màn hình."><input type="hidden" name="csrf" value="${sessionScope.csrf}"><label>Chỉ định đã thanh toán</label><select name="orderId" required><c:forEach items="${orders}" var="o"><c:if test="${o.payment_status=='PAID' && o.status=='PENDING'}"><option value="${o.order_id}">#${o.order_id} · <c:out value="${o.patient_name}"/> · <c:out value="${o.name}"/></option></c:if></c:forEach></select><label>Dữ liệu kết quả *</label><textarea name="resultData" required maxlength="10000"></textarea><label>Kết luận</label><textarea name="conclusion" maxlength="255"></textarea><label>URL báo cáo đính kèm (HTTPS)</label><input type="url" name="fileUrl" maxlength="255" placeholder="https://..."><p></p><button>Lưu & duyệt kết quả</button></form></div><%@ include file="_footer.jspf" %>
