<%@ include file="_header.jspf" %><div class="card"><h1>Đơn thuốc #${prescription.prescription_id}</h1><p>Bác sĩ: <c:out value="${prescription.doctor_name}"/></p><p>Bệnh nhân: <c:out value="${prescription.patient_name}"/> · mã ${prescription.patient_id}</p><p>Chẩn đoán: <c:out value="${prescription.diagnosis}"/></p><p>Ngày kê: ${prescription.prescribed_date}</p><div class="table-wrap"><table><thead><tr><th>Thuốc</th><th>Số lượng</th><th>Đơn vị</th><th>Liều dùng</th><th>Đơn giá</th></tr></thead><tbody><c:forEach items="${items}" var="i"><tr><td><c:out value="${i.name}"/></td><td>${i.quantity}</td><td><c:out value="${i.unit}"/></td><td><c:out value="${i.dosage}"/></td><td><fmt:formatNumber value="${i.unit_price}"/></td></tr></c:forEach></tbody></table></div><p>Lời dặn: <c:out value="${prescription.advice}"/></p><p class="no-print"><button data-print>In đơn thuốc</button> <a href="${ctx}/emr">Trở về bệnh án</a></p></div><%@ include file="_footer.jspf" %>
