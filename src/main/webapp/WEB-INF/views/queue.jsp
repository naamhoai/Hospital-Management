<%@ include file="_header.jspf" %><h1>Hàng đợi khám hôm nay</h1><c:if test="${role=='DOCTOR'}"><form method="post"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="action" value="next"><button>Gọi bệnh nhân tiếp theo</button></form><p><a href="${ctx}/emr">Mở bệnh án đang xử lý</a></p></c:if><div class="card"><ui:dataTable rows="${queue}"/></div>
<c:if test="${role=='RECEPTIONIST' || role=='ADMIN'}"><div class="card"><h2>Điều phối phòng cùng chuyên khoa</h2><form class="row" method="post"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="action" value="route"><div><label>Mã phiếu chờ</label><input type="number" name="queueId" required min="1"></div><div><label>Phòng đích</label><select name="room" required><c:forEach items="${rooms}" var="room"><option value="${room.room_number}"><c:out value="${room.room_number}"/> · <c:out value="${room.room_name}"/></option></c:forEach></select></div><button>Chuyển phòng</button></form></div></c:if><%@ include file="_footer.jspf" %>
