<%@ include file="_header.jspf" %><h1>Tiếp nhận bệnh nhân</h1><div class="card"><form class="row" method="get"><div><label>Tìm mã lịch, số điện thoại hoặc tên</label><input name="keyword" value="<c:out value='${param.keyword}'/>"></div><button>Tìm trong hôm nay</button></form><p></p><ui:dataTable rows="${appointments}"/></div>
<div class="grid"><div class="card"><h2>Check-in lịch đã đặt</h2><form method="post"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="action" value="checkin"><label>Lịch khám</label><select name="appointmentId" required><c:forEach items="${appointments}" var="a"><c:if test="${a.status=='BOOKED'}"><option value="${a.appointment_id}"><c:out value="${a.appointment_code}"/> · <c:out value="${a.patient_name}"/></option></c:if></c:forEach></select><label>Ưu tiên</label><select name="priority"><option value="STANDARD">Thông thường</option><option value="ELDERLY">Người cao tuổi</option><option value="EMERGENCY">Khẩn cấp</option></select><p></p><button>Cấp số chờ</button></form></div>
<div class="card"><h2>Đăng ký khám trực tiếp</h2><form method="post"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="action" value="walkin"><label>Bệnh nhân đã có hồ sơ</label><select name="patientId" required><c:forEach items="${patients}" var="p"><option value="${p.patient_id}"><c:out value="${p.full_name}"/> · <c:out value="${p.email}"/></option></c:forEach></select><label>Ca khám hôm nay còn chỗ</label><select name="scheduleId" required><c:forEach items="${schedules}" var="w"><option value="${w.schedule_id}">#${w.schedule_id} · <c:out value="${w.doctor_name}"/> · ${w.work_date} ${w.start_time}</option></c:forEach></select><label>Triệu chứng *</label><input name="symptoms" maxlength="255" required><label>Ưu tiên</label><select name="priority"><option value="STANDARD">Thông thường</option><option value="ELDERLY">Người cao tuổi</option><option value="EMERGENCY">Khẩn cấp</option></select><p></p><button>Đăng ký & cấp số</button></form></div></div><%@ include file="_footer.jspf" %>
