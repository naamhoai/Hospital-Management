<%@ include file="_header.jspf" %><h1>Báo cáo & phân tích</h1><div class="card"><form method="get"><div class="row"><div><label>Loại báo cáo</label><select name="type"><option value="flow" ${type=='flow'?'selected':''}>Lưu lượng bệnh nhân</option><option value="revenue" ${type=='revenue'?'selected':''}>Doanh thu đã thanh toán</option></select></div><div><label>Từ ngày</label><input type="date" name="from" value="${from}" required></div><div><label>Đến ngày</label><input type="date" name="to" value="${to}" required></div><div><label>Phương thức (doanh thu)</label><select name="method"><option value="">Tất cả</option><option value="CASH" ${param.method=='CASH'?'selected':''}>Tiền mặt</option><option value="VNPAY" ${param.method=='VNPAY'?'selected':''}>VNPay</option></select></div></div><p></p><button name="format" value="html">Xem báo cáo</button> <button class="secondary" name="format" value="xlsx">Xuất Excel</button> <button class="secondary" name="format" value="pdf">Xuất PDF</button></form></div>
<c:if test="${type=='flow' && not empty rows}"><div class="card"><h2>Tỷ lệ khám hoàn tất theo ngày (%)</h2><c:forEach items="${rows}" var="row"><div class="chart-row"><span>${row.day}</span><div><div class="bar" data-bar="${row.completion_rate}"></div></div><strong>${row.completion_rate}%</strong></div></c:forEach></div></c:if><div class="card"><h2>Kết quả tổng hợp</h2><p class="muted">Doanh thu chỉ tính hóa đơn PAID theo ngày thanh toán; số lượt khám tính theo lịch hẹn.</p><ui:dataTable rows="${rows}"/></div><%@ include file="_footer.jspf" %>
