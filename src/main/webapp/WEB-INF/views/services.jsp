<%@ include file="_header.jspf" %><h1>Danh mục dịch vụ & giá</h1><div class="card"><ui:dataTable rows="${services}"/></div><div class="card"><h2>Thêm / cập nhật dịch vụ</h2><form method="post"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><div class="row"><div><label>Mã dịch vụ (để trống khi thêm)</label><input type="number" name="serviceId" min="1"></div><div><label>Tên dịch vụ *</label><input name="name" required maxlength="100"></div><div><label>Chuyên khoa</label><select name="departmentId"><c:forEach items="${departments}" var="d"><option value="${d.department_id}"><c:out value="${d.name}"/></option></c:forEach></select></div></div><div class="row"><div><label>Phân loại</label><select name="category"><option value="CONSULTATION">Khám bệnh</option><option value="LAB">Xét nghiệm</option><option value="IMAGING">Chẩn đoán hình ảnh</option></select></div><div><label>Đơn giá VND *</label><input type="number" name="price" required min="0" step="1"></div><div><label>Trạng thái</label><select name="status"><option value="ACTIVE">Hoạt động</option><option value="INACTIVE">Ngừng hoạt động</option></select></div><button>Lưu dịch vụ</button></div></form></div><%@ include file="_footer.jspf" %>
